# Copy this file to .env and fill in your key.
# Without a key the game runs in offline demo mode (simple keyword rules).

# --- DeepSeek (default) ---
LLM_API_KEY=your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- Any other OpenAI-compatible provider works. Examples: ---
# OpenAI:        LLM_BASE_URL=https://api.openai.com/v1     LLM_MODEL=gpt-4o-mini
# Ollama (free, local, no key):  LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen2.5:14b
# OpenRouter:    LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=deepseek/deepseek-chat

# Set to false if your provider rejects response_format: {type: "json_object"}
LLM_JSON_MODE=true
LLM_TIMEOUT_MS=90000

PORT=3000
